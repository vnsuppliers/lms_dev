<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Data from the server (make sure to provide this data in your PHP view)
    var xValues = @json($xvalues);
    var assignedYValues = @json($assignedyvalues);

    // Prepare data points similar to the CanvasJS example format
    var dataPoints = xValues.map(function(label, index) {
        return { label: label, y: assignedYValues[index] };
    });

    // Create the chart using CanvasJS
    var chart = new CanvasJS.Chart("enrollmentchart", {
        animationEnabled: true,
        theme: "light2", // Can also be "light1", "dark1", "dark2"
        title: {
            text: "Assigned Users Data"
        },
        axisY: {
            title: "Count",
            includeZero: true
        },
        data: [{
            type: "column",
            dataPoints: dataPoints // Data points in the CanvasJS format
        }]
    });

    // Render the chart
    chart.render();
});
</script>




