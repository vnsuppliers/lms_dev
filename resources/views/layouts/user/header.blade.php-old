                                    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
                                    <script>
                                    $(document).ready(function() {
                                        $('#nav-contact-tab').click(function() {
                                            // Clear notifications count badge
                                            $('#nav-contact-tab .badge').remove();

                                            // Show notification content
                                            $('#notificationContent').show();

                                            // AJAX request to mark all notifications as read
                                            $.ajax({
                                                type: 'POST',
                                                url: '{{ url("markAllNotificationsAsRead") }}', // Adjust the route to your backend endpoint
                                                data: {
                                                    _token: '{{ csrf_token() }}'
                                                }, // Pass CSRF token if required
                                                success: function(response) {
                                                    console.log(
                                                        'All notifications marked as read.'
                                                    );
                                                },
                                                error: function(xhr, status, error) {
                                                    console.error(
                                                        'Error marking notifications as read:',
                                                        error);
                                                }
                                            });
                                        });
                                    });
                                    </script>