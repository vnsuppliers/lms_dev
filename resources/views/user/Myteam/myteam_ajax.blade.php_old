 <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<script type="text/javascript">

    $(document).ready(function() {
        
        var chartInitialized = false;

        $('.take_result').click(function(){
            var link = $(this).data('link');
            window.open(link, "popupWindow", "width=1200, height=800, scrollbars=yes");
        });


        $('body').on('click', '.get_certificates', function(){
            var assign_id = $(this).data('id');
            $.ajax({
                type: "GET",
                url: "{{ url('get_certificate') }}",
                data: {
                    assign_id: assign_id
                },
                dataType: "html",
                success: function(response) {
                    $('.certificate_html').html(response);
                },
                error: function(xhr, status, error) {
                    console.error("Error saving video time:", error);
                }
            });
        });

        
        if (!chartInitialized) {
            chartInitialized = true;
            const e = {
                init() {
                    new ApexCharts(document.querySelector("#bsb-chart-2"), {
                        series: [{{$completed_course}}, {{$inprogress_count}}, {{$pending_count}}, {{$instructor_lead}}],
                        labels: ["Completed", "In-Progress", "Pending", "Instructor Led"],
                        legend: {
                            show: false 
                        },
                        theme: { palette: "palette1" },
                        chart: { type: "donut" },
                        plotOptions: {
                            pie: {
                                donut: {
                                    labels: {
                                        show: false 
                                    }
                                }
                            }
                        },
                        colors: [
                            "#cfcbc9", 
                            "#d3e1df", 
                            "#eadccf",
                            "#e0d4d5"
                        ],
                    }).render();
                },
            };

            
            function t() {
                e.init();
            }

          
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", t);
            } else {
                t();
            }
        }
    });

</script>
