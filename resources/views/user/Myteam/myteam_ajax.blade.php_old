                                            @php
                                                $courseAssessments = optional($data->course_details)->assessments ?? collect();
                                                
                                                // Find assessment with result or fallback to first
                                                $matchedAssessment = $courseAssessments->first(function($assess) use ($allResults) {
                                                    return !empty($allResults[$assess->id] ?? $allResults[(string)$assess->id] ?? null);
                                                });

                                                if (!$matchedAssessment && $courseAssessments->isNotEmpty()) {
                                                    $matchedAssessment = $courseAssessments->first();
                                                }
                                                
                                                $validAssessments = $matchedAssessment ? collect([$matchedAssessment]) : collect();
                                            @endphp

                                            @foreach ($validAssessments as $assess)
                                                @php
                                                    $result_datas = $allResults[$assess->id] ?? $allResults[(string)$assess->id] ?? null;
                                                    
                                                    $result_html = '';
                                                    $assessmentStatus = 'Pending';

                                                    if (!empty($result_datas)) {
                                                        $assessmentStatus = 'Passed';
                                                        $link = explode('/', $assess->file_path ?? '');
                                                        $result_link = ($link[0] ?? '') . '/' . ($link[1] ?? '') . '/results/' . ($result_datas->code ?? '');
                                                        
                                                        $result_html = '<a href="javascript:;" data-link="https://assessment.digicat.ai/start_assessment?url=' . $result_link . '&email=' . $user->email . '&username=' . $user->username . '&first_name=' . $user->first_name . '&last_name=' . $user->emp_id . '&course_id=' . $assess->id . '&assign_id=' . $data->id . '" class="btn btn-sm btn-primary text-nowrap take_result exam-result-btn">View Result</a>';
                                                    } elseif ($data->status == 3) {
                                                        // Fallback if course is completed/passed (status 3) but result row lookup missed
                                                        $assessmentStatus = 'Passed';
                                                        $link = explode('/', $assess->file_path ?? '');
                                                        $fallback_code = $assess->id;
                                                        $result_link = ($link[0] ?? '') . '/' . ($link[1] ?? '') . '/results/' . $fallback_code;

                                                        $result_html = '<a href="javascript:;" data-link="https://assessment.digicat.ai/start_assessment?url=' . $result_link . '&email=' . $user->email . '&username=' . $user->username . '&first_name=' . $user->first_name . '&last_name=' . $user->emp_id . '&course_id=' . $assess->id . '&assign_id=' . $data->id . '" class="btn btn-sm btn-primary text-nowrap take_result exam-result-btn">View Result</a>';
                                                    } else {
                                                        if ($data->status == 1) {
                                                            $assessmentStatus = 'In Progress';
                                                        } elseif ($data->status == 2) {
                                                            $assessmentStatus = 'Not Attended';
                                                        }
                                                    }
                                                @endphp

                                                <div class="row mt-2 mb-3">
